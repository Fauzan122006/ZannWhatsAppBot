<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Zann Multi-Bot Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: #0f0f1e; color: #e0e0e0; }
    .glass { background: rgba(30, 30, 50, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
    .sidebar { background: linear-gradient(135deg, #1e1e3f 0%, #2d2d5f 100%); }
  </style>
</head>
<body>
  <div class="flex h-screen">
    <%- include('partials/sidebar') %>

    <div class="flex-1 p-8 overflow-y-auto">
      <h1 class="text-3xl font-bold text-white mb-8">⚙️ Settings</h1>

      <form id="settingsForm" class="space-y-6">
        <!-- Watermark -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">🏷️ Sticker Watermark</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-white/60 mb-2">Pack Name</label>
              <input type="text" name="watermark.packname" value="<%= settings.watermark.packname %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Author</label>
              <input type="text" name="watermark.author" value="<%= settings.watermark.author %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">URL</label>
              <input type="text" name="watermark.url" value="<%= settings.watermark.url %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
          </div>
        </div>

        <!-- Identity -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">👤 Bot Identity</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-white/60 mb-2">Bot Name</label>
              <input type="text" name="identity.botName" value="<%= settings.identity.botName %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Owner Name</label>
              <input type="text" name="identity.ownerName" value="<%= settings.identity.ownerName %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Owner Number</label>
              <input type="text" name="identity.ownerNumber" value="<%= settings.identity.ownerNumber %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Footer Text</label>
              <input type="text" name="identity.footerText" value="<%= settings.identity.footerText %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
          </div>
        </div>

        <!-- Behavior -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">🎮 Bot Behavior</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="checkbox" name="behavior.autoRead" <%= settings.behavior.autoRead ? 'checked' : '' %>
                     class="w-5 h-5 rounded">
              <span class="text-white">Auto Read</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="checkbox" name="behavior.autoTyping" <%= settings.behavior.autoTyping ? 'checked' : '' %>
                     class="w-5 h-5 rounded">
              <span class="text-white">Auto Typing</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="checkbox" name="behavior.welcomeMessage" <%= settings.behavior.welcomeMessage ? 'checked' : '' %>
                     class="w-5 h-5 rounded">
              <span class="text-white">Welcome Msg</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="checkbox" name="behavior.antiCall" <%= settings.behavior.antiCall ? 'checked' : '' %>
                     class="w-5 h-5 rounded">
              <span class="text-white">Anti Call</span>
            </label>
          </div>
        </div>

        <!-- API Keys -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">🔑 API Keys</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-white/60 mb-2">OpenAI</label>
              <input type="password" name="apiKeys.openai" value="<%= settings.apiKeys.openai %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Gemini</label>
              <input type="password" name="apiKeys.gemini" value="<%= settings.apiKeys.gemini %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">RemoveBG</label>
              <input type="password" name="apiKeys.removebg" value="<%= settings.apiKeys.removebg %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
            <div>
              <label class="block text-white/60 mb-2">Weather API</label>
              <input type="password" name="apiKeys.weatherapi" value="<%= settings.apiKeys.weatherapi %>" 
                     class="w-full px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white">
            </div>
          </div>
        </div>

        <button type="submit" class="w-full px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-bold rounded-lg transition">
          💾 Save Settings
        </button>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('settingsForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const settings = {};
      
      for (const [key, value] of formData.entries()) {
        const keys = key.split('.');
        let current = settings;
        
        for (let i = 0; i < keys.length - 1; i++) {
          if (!current[keys[i]]) current[keys[i]] = {};
          current = current[keys[i]];
        }
        
        const lastKey = keys[keys.length - 1];
        current[lastKey] = e.target[key].type === 'checkbox' ? e.target[key].checked : value;
      }

      const response = await fetch('/settings/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings)
      });

      const result = await response.json();
      alert(result.message);
      if (result.success) location.reload();
    });
  </script>
</body>
</html>
