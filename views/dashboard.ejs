<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Zann Multi-Bot Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.socket.io/4.6.0/socket.io.min.js"></script>
  <style>
    body {
      background: #0f0f1e;
      color: #e0e0e0;
    }
    .glass {
      background: rgba(30, 30, 50, 0.7);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sidebar {
      background: linear-gradient(135deg, #1e1e3f 0%, #2d2d5f 100%);
    }
    .status-online {
      background: #10b981;
      animation: pulse 2s infinite;
    }
    .status-offline {
      background: #ef4444;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
  </style>
</head>
<body>
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="sidebar w-64 p-6 flex flex-col">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-white">🚀 ZANN</h1>
        <p class="text-white/60 text-sm">Multi-Bot Manager v2.0</p>
      </div>

      <nav class="flex-1 space-y-2">
        <a href="/dashboard?session=active" class="block px-4 py-3 rounded-lg bg-white/10 text-white hover:bg-white/20 transition">
          📊 Dashboard
        </a>
        <a href="/settings?session=active" class="block px-4 py-3 rounded-lg text-white/70 hover:bg-white/10 transition">
          ⚙️ Settings
        </a>
        <a href="/broadcast?session=active" class="block px-4 py-3 rounded-lg text-white/70 hover:bg-white/10 transition">
          📢 Broadcast
        </a>
        <a href="/features?session=active" class="block px-4 py-3 rounded-lg text-white/70 hover:bg-white/10 transition">
          🎯 Features
        </a>
        <a href="/logs?session=active" class="block px-4 py-3 rounded-lg text-white/70 hover:bg-white/10 transition">
          📝 Logs
        </a>
      </nav>

      <div class="border-t border-white/10 pt-4">
        <a href="/" class="block px-4 py-3 rounded-lg text-red-400 hover:bg-red-500/10 transition">
          🚪 Logout
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 p-8 overflow-y-auto">
      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="glass rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white/60">Active Instances</span>
            <span class="text-2xl">🤖</span>
          </div>
          <div class="text-3xl font-bold text-white" id="activeInstances">0</div>
        </div>

        <div class="glass rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white/60">CPU Usage</span>
            <span class="text-2xl">💻</span>
          </div>
          <div class="text-3xl font-bold text-white" id="cpuUsage">0%</div>
        </div>

        <div class="glass rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white/60">Memory</span>
            <span class="text-2xl">🧠</span>
          </div>
          <div class="text-3xl font-bold text-white" id="memoryUsage">0%</div>
        </div>

        <div class="glass rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white/60">Uptime</span>
            <span class="text-2xl">⏱️</span>
          </div>
          <div class="text-3xl font-bold text-white" id="uptime">0h</div>
        </div>
      </div>

      <!-- Instances List -->
      <div class="glass rounded-xl p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-white">Bot Instances</h2>
          <button onclick="createInstance()" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition">
            ➕ Create Instance
          </button>
        </div>

        <div id="instancesList" class="space-y-4">
          <% instances.forEach(instance => { %>
            <div class="glass rounded-lg p-4 flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="status-<%= instance.status === 'connected' ? 'online' : 'offline' %> w-3 h-3 rounded-full"></div>
                <div>
                  <div class="text-white font-bold"><%= instance.name %></div>
                  <div class="text-white/60 text-sm">ID: <%= instance.id %></div>
                </div>
              </div>

              <div class="flex items-center space-x-6">
                <div class="text-white/80">
                  📨 <%= instance.messageCount || 0 %> messages
                </div>
                <div class="flex space-x-2">
                  <% if (instance.status !== 'connected') { %>
                    <button onclick="showQR('<%= instance.id %>')" class="px-3 py-1 bg-green-500 hover:bg-green-600 text-white rounded transition text-sm">
                      📱 QR Code
                    </button>
                  <% } %>
                  <button onclick="deleteInstance('<%= instance.id %>')" class="px-3 py-1 bg-red-500 hover:bg-red-600 text-white rounded transition text-sm">
                    🗑️ Delete
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- QR Code Modal -->
      <div id="qrModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="glass rounded-xl p-8 max-w-md w-full mx-4">
          <h3 class="text-2xl font-bold text-white mb-4">Scan QR Code</h3>
          <div id="qrContainer" class="bg-white p-4 rounded-lg mb-4 flex items-center justify-center min-h-[256px]">
            <span class="text-gray-500">Generating QR Code...</span>
          </div>
          <button onclick="closeQR()" class="w-full px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const socket = io();

    // System stats update
    socket.on('systemStats', (data) => {
      document.getElementById('cpuUsage').textContent = data.cpu + '%';
      document.getElementById('memoryUsage').textContent = data.memory + '%';
      document.getElementById('activeInstances').textContent = data.instances.filter(i => i.status === 'connected').length;
      
      const hours = Math.floor(data.uptime / 3600000);
      const minutes = Math.floor((data.uptime % 3600000) / 60000);
      document.getElementById('uptime').textContent = `${hours}h ${minutes}m`;
    });

    // QR Code
    socket.on('qr', (data) => {
      document.getElementById('qrContainer').innerHTML = `<img src="${data.qr}" class="w-64 h-64">`;
    });

    // Instance status
    socket.on('instanceStatus', (data) => {
      location.reload();
    });

    function createInstance() {
      const name = prompt('Enter instance name:');
      if (name) {
        fetch('/instance/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name })
        })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            location.reload();
          }
        });
      }
    }

    function deleteInstance(id) {
      if (confirm('Are you sure?')) {
        fetch(`/instance/delete/${id}`, { method: 'POST' })
          .then(() => location.reload());
      }
    }

    function showQR(instanceId) {
      document.getElementById('qrModal').classList.remove('hidden');
      socket.emit('requestQR', instanceId);
    }

    function closeQR() {
      document.getElementById('qrModal').classList.add('hidden');
    }
  </script>
</body>
</html>
